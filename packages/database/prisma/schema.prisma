generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Shipment {
  id           String   @id @default(uuid())
  trackingId   String   @unique
  origin       String
  destination  String
  status       String
  aiRiskScore  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
