{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "declaration": true, "declarationMap": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "inlineSources": false,
    "isolatedModules": true, "moduleDetection": "force",
    "noUncheckedIndexedAccess": true, "resolveJsonModule": true,
    "skipLibCheck": true, "strict": true, "strictNullChecks": true
  }
}