{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["dom","dom.iterable","esnext"],
    "module": "esnext", "moduleResolution": "bundler",
    "allowJs": true, "jsx": "preserve", "target": "ES2017",
    "allowImportingTsExtensions": true, "noEmit": true
  }
}