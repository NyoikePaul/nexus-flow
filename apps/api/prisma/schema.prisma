generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  DELAYED
  CANCELLED
}

model Shipment {
  id          String         @id @default(uuid())
  trackingId  String         @unique
  origin      String
  destination String
  status      ShipmentStatus @default(PENDING)
  aiRiskScore Float          @default(0) @map("ai_risk_score")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([trackingId])
  @@map("shipments")
}
